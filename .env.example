# ===== Account Service =====
ACCOUNT_DB_USER=postgres
ACCOUNT_DB_PASSWORD=postgres
ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_HOST=localhost
ACCOUNT_DB_PORT=5433

# ===== Transaction Service =====
TRANSACTION_DB_USER=postgres
TRANSACTION_DB_PASSWORD=postgres
TRANSACTION_DB_NAME=transaction_db
TRANSACTION_DB_HOST=localhost
TRANSACTION_DB_PORT=5434

# ===== Shared (Account 與 Transaction 都會用) =====
# JWT key 必須與 Account Service 一致，這樣兩邊才能互相驗證 token
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Internal API key 在跨服務內部呼叫時帶在 X-Internal-Key header
INTERNAL_API_KEY=dev-internal-key

# ===== 跨服務 base URL（Transaction Service 會打它們）=====
ACCOUNT_SERVICE_URL=http://localhost:8000
EVENT_SERVICE_URL=http://localhost:3000
TICKET_SERVICE_URL=http://localhost:8001

# Ticket Service 是否啟用（feature/ticket-service 尚未 merge 前先 false）
TICKET_SERVICE_ENABLED=false

# Environment（local / production）
ENV=local